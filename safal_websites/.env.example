# Copy to .env and fill in. Never commit or share .env.

# Protects /admin and /api/leads (HTTP Basic auth). Leave ADMIN_PASSWORD empty to disable them.
ADMIN_USER=admin
ADMIN_PASSWORD=

# The leads API. Get the URL (and how it expects the key) from the API's documentation.
LEADS_API_URL=
LEADS_API_KEY=
# How the key is sent: bearer | x-api-key | header:<Header-Name> | query:<param-name>
LEADS_API_AUTH=bearer

# PORT=3000
# HOST=127.0.0.1
